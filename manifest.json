{
  "manifest_version": 3,
  "name": "Chat Turn Rail",
  "version": "1.4.0",
  "description": "Preview, search, and jump to prompts, and copy formulas as LaTeX in ChatGPT Chat and Work.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Chat Turn Rail",
    "default_popup": "settings.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "exclude_matches": ["https://chatgpt.com/codex*"],
      "css": ["formula-copy.css"],
      "js": ["defaults.js", "styles.js", "navigator.js", "formula-copy.js"],
      "run_at": "document_idle"
    }
  ]
}
